    { "id": "devops", "lane": "devops", "col": 5, "type": "cloud", "label": "DevOps", "sublabel": "deploy + migraciones", "width": 140 },
    { "id": "final", "lane": "usuario", "col": 5, "type": "backend", "label": "Entregado", "sublabel": "verificado + notificado", "width": 140 }
