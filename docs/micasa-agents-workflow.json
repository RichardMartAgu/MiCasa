    { "id": "e-audit-exec", "from": "audit", "to": "exec", "label": "BLOQUEADO", "variant": "security", "role": "error" },
    { "id": "e-audit-qa", "from": "audit", "to": "qa", "label": "APROBADO", "variant": "emphasis" },
    { "id": "e-qa-exec", "from": "qa", "to": "exec", "label": "FALLA", "variant": "security", "role": "error" },
