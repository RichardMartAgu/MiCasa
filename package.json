{
  "name": "micasa",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~58.0.17",
    "expo-auth-session": "~58.0.14",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~30.5.2",
    "jest-expo": "57.0.4",
    "path-to-regexp": "^6.3.0",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && npm run build:pwa && npm run check:csp",
    "build:pwa": "npm run build:sw && workbox injectManifest workbox-config.js",
    "check:csp": "node scripts/check-csp.mjs",
    "check:lock": "node scripts/check-lock-integrity.mjs",
    "verify:pwa": "node scripts/verify-pwa.cjs && npm run check:csp",
    "demo": "bash scripts/serve-demo.sh",
    "deploy:vercel": "npx vercel --prod --yes",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "build:sw": "esbuild sw-src.js --bundle --format=iife --target=es2020 --outfile=sw-bundle.js",
    "verify:deps": "npm run check:lock && npm run check:overrides && npm audit --omit=dev --audit-level=high && npm audit --audit-level=high",
    "check:overrides": "node scripts/check-overrides.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "maxWorkers": 4,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "!src/lib/supabase.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/"
    ]
  },
  "private": true,
  "overrides": {
    "tmp": "^0.2.5",
    "uuid": "^11.1.1"
  }
}
