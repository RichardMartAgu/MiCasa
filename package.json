{
  "name": "micasa",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-calendar": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~30.5.1",
"jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.8",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "demo": "bash scripts/serve-demo.sh",
    "deploy:vercel": "npx vercel --prod --yes",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.ts",
      "!src/lib/supabase.ts"
    ]
  },
  "private": true
}
