# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# autoskills (regenerables con `npx autoskills`)
.claude/skills/
.agents/
.opencode/*
!.opencode/skills/
skills-lock.json

# typescript
*.tsbuildinfo

# coverage
coverage/

example

# generated native folders
/ios
/android
.vercel

# local env files — las reglas completas viven aquí, no duplicadas arriba
.env*
!.env.example

# Supabase CLI
supabase/.temp/

# service worker empaquetado (generado por npm run build:sw)
sw-bundle.js

# `node_modules/` con barra no cubre un symlink, que es como se enlaza en los
# worktrees para no reinstalar 1700 paquetes en cada uno.
node_modules

# Este lock es el de la RAÍZ, que contiene el árbol de Expo y no ejecuta nadie:
# un artefacto local. El de la Edge Function
# (`supabase/functions/send-web-push/deno.lock`) está commiteado a propósito y
# CI lo verifica, porque sus tests sí corren allí y sus dependencias sí están
# fijadas. A un fichero ya trackeado esta regla no le aplica.
/deno.lock
